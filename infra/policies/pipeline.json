{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteProjectData",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": ["${data_bucket_arn}/*", "${artifacts_bucket_arn}/*"]
    },
    {
      "Sid": "ListProjectData",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["${data_bucket_arn}", "${artifacts_bucket_arn}"]
    },
    {
      "Sid": "ReadWriteMetadata",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query"
      ],
      "Resource": "${metadata_table_arn}"
    }
  ]
}
