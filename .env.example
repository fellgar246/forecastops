EXECUTION_MODE=local
AWS_ENABLED=false
# Local mode leaves authentication off and stamps every row with tenant "local".
# Cloud mode requires AUTH_ENABLED=true plus the Cognito settings below.
AUTH_ENABLED=false
BEDROCK_ENABLED=false
SAGEMAKER_ENABLED=false
ONLINE_INFERENCE=false
AI_ENABLED=true
TRAINING_ENABLED=true
AWS_ML_ENABLED=false

MAX_BEDROCK_CALLS_PER_DAY=30
MAX_BEDROCK_INPUT_TOKENS=5000
MAX_BEDROCK_OUTPUT_TOKENS=700
# Foundation model used when BEDROCK_ENABLED=true.
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
MAX_TRAINING_JOBS_PER_DAY=2
MAX_TRAINING_RUNTIME_MINUTES=45
ALLOW_GPU_TRAINING=false
MAX_BATCH_INFERENCE_JOBS_PER_DAY=5
MAX_DATASET_ROWS_DEMO=2000000
MAX_FORECAST_HORIZON_DAYS=90

RANDOM_SEED=20260921

# Drift monitoring compares the last RECENT_WINDOW_DAYS with the earlier baseline.
# PSI above PSI_RETRAIN_THRESHOLD recommends retraining. PSI above
# PSI_WARNING_THRESHOLD and at or below PSI_RETRAIN_THRESHOLD is a warning.
# Recent WAPE more than WAPE_DEGRADATION_LIMIT worse than the approved model
# also recommends retraining, as does a dataset whose date_max is more than
# MAX_DATASET_AGE_DAYS before the report as_of date.
PSI_WARNING_THRESHOLD=0.1
PSI_RETRAIN_THRESHOLD=0.2
WAPE_DEGRADATION_LIMIT=0.2
MAX_DATASET_AGE_DAYS=30
FREQUENCY_WARNING_DELTA=0.05
RECENT_WINDOW_DAYS=28

# Remote artifact bucket. Required only when AWS_ENABLED=true.
# ARTIFACTS_BUCKET=
# AWS_REGION=us-east-1

# DynamoDB table for domain documents. Required only when EXECUTION_MODE=aws.
# METADATA_TABLE_NAME=

# Cognito access tokens. Required only when AUTH_ENABLED=true.
# COGNITO_USER_POOL_ID=
# COGNITO_APP_CLIENT_ID=

# Web sign-in. Leave unset or false so local mode hides the sign-in form.
# NEXT_PUBLIC_AUTH_ENABLED=false
# NEXT_PUBLIC_COGNITO_REGION=us-east-1
# NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Role assumed by a manual DeepAR training job. Required only when that job is submitted.
# DEEPAR_ROLE_ARN=

# Role assumed by a manual training pipeline. Required only when that pipeline is started.
# PIPELINE_ROLE_ARN=

# Local PostgreSQL connection for the API. Compose overrides the host name.
DATABASE_URL=postgresql+psycopg://forecastops:forecastops@localhost:5432/forecastops
